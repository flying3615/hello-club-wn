#!/bin/sh
set -eu

[ "$#" -eq 0 ] || { echo "This helper accepts no arguments." >&2; exit 64; }

REQUEST_USER="${SUDO_USER:-}"
[ -n "$REQUEST_USER" ] && [ "$REQUEST_USER" != "root" ] || {
  echo "This helper must be invoked through sudo by the booking user." >&2
  exit 67
}
case "$REQUEST_USER" in
  *[!A-Za-z0-9._-]*) echo "Invalid sudo user name." >&2; exit 67 ;;
esac

PROJECT_DIR="$(/bin/pwd -P)"
[ -n "$PROJECT_DIR" ] || { echo "Project working directory is missing." >&2; exit 68; }
PLAN_FILE="$PROJECT_DIR/state/wake/rtc-wake.txt"
[ -r "$PLAN_FILE" ] || { echo "RTC wake request is missing." >&2; exit 66; }
[ "$(/usr/bin/wc -l < "$PLAN_FILE")" -eq 1 ] || { echo "RTC wake request must contain exactly one line." >&2; exit 65; }

IFS= read -r wake_at < "$PLAN_FILE"
printf '%s\n' "$wake_at" | /usr/bin/grep -Eq '^[0-9]{2}/[0-9]{2}/[0-9]{2} 06:53:00$' || {
  echo "RTC wake request must be a date at 06:53:00." >&2
  exit 65
}

exec /usr/bin/pmset schedule wake "$wake_at" com.hermes.hello-club
